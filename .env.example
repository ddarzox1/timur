# Скопируйте в .env:  cp .env.example .env   (или: make env)
# Этот файл читают и docker compose, и `make run`.

# --- База данных (docker compose) ---
# На сервере обязательно поменяйте.
POSTGRES_PASSWORD=qauipsiz

# --- Приложение при запуске на хосте (`make run`) ---
# В docker адрес базы собирается сам из POSTGRES_PASSWORD, эта строка там не используется.
DATABASE_URL=postgres://qauipsiz:qauipsiz@localhost:5433/qauipsiz?sslmode=disable
ADDR=:8080
# Адрес сайта — для ссылок в SMS.
BASE_URL=http://localhost:8080
# --- Хранилище файлов ---
# local — файлы на диске в UPLOADS_DIR (на сервере нужен том);
# s3    — S3-совместимое хранилище (PS Cloud, QazCloud, Yandex, MinIO, AWS). Бакет приватный,
#         файлы отдаются по ссылке с подписью на 5 минут после проверки прав. Том не нужен.
#         Для персональных данных граждан РК выбирайте хранилище в Казахстане.
STORAGE=local
# Для make up-s3 (локальный S3 на SeaweedFS) подходят значения ниже как есть.
S3_ENDPOINT=localhost:9000
S3_REGION=
S3_BUCKET=qauipsiz
S3_ACCESS_KEY=qauipsiz
S3_SECRET_KEY=qauipsiz-secret
# 1 — https (боевое хранилище, по умолчанию), 0 — http (локальный S3).
S3_USE_SSL=0

# Папка для загруженных файлов: фото опасностей и чек-листов, селфи при подписи, PDF/видео инструктажей,
# планы эвакуации. Внутри — подпапка на каждую организацию. В Docker это /app/uploads на томе `uploads`;
# на сервере (Dokploy) сюда обязательно монтируйте том, иначе файлы пропадут при деплое.
UPLOADS_DIR=uploads
# Цена за сотрудника в месяц, ₸ (показывается на лендинге и в настройках).
PRICE_PER_USER=9990

# --- Только для разработки! На проде удалите обе строки ---
# Демо-организация ТОО «Строй-Инвест» в пустой базе.
SEED=1
# Общий код входа для всех номеров, пока не подключён SMS-провайдер.
FIXED_OTP=1111

# --- Прод ---
# 1 — cookie только по HTTPS. С ним сервер не запустится, если задан FIXED_OTP.
COOKIE_SECURE=
