# Скопируйте в .env:  cp .env.example .env   (или: make env)
# Этот файл читают и docker compose, и `make run`.

# --- База данных (docker compose) ---
# На сервере обязательно поменяйте.
POSTGRES_PASSWORD=qauipsiz

# --- Приложение при запуске на хосте (`make run`) ---
# В docker адрес базы собирается сам из POSTGRES_PASSWORD, эта строка там не используется.
DATABASE_URL=postgres://qauipsiz:qauipsiz@localhost:5433/qauipsiz?sslmode=disable
ADDR=:8080
# Адрес сайта — для ссылок в SMS.
BASE_URL=http://localhost:8080
UPLOADS_DIR=uploads
# Цена за сотрудника в месяц, ₸ (показывается на лендинге и в настройках).
PRICE_PER_USER=990

# --- Только для разработки! На проде удалите обе строки ---
# Демо-организация ТОО «Строй-Инвест» в пустой базе.
SEED=1
# Общий код входа для всех номеров, пока не подключён SMS-провайдер.
FIXED_OTP=1111

# --- Прод ---
# 1 — cookie только по HTTPS. С ним сервер не запустится, если задан FIXED_OTP.
COOKIE_SECURE=
